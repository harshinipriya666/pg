# =========================================================
# PG MANAGEMENT SYSTEM - BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in values for local dev.
# On Render, set these directly in the Environment tab.
# =========================================================

# --- Database (Required) ---
# For local dev: use your local MySQL
# For Render: use PlanetScale / Railway / Render MySQL connection string
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/pg_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# --- CORS (Required in production) ---
# Set this to your Vercel frontend URL, e.g.: https://pg-management.vercel.app
FRONTEND_URL=http://localhost:5173

# --- Server Port ---
# Render sets this automatically; leave blank for local (defaults to 8080)
PORT=8080

# --- AI (Optional) ---
# Get a free key at https://aistudio.google.com/app/apikey
# If omitted, AI features run in deterministic fallback mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
